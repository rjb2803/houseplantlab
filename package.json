{
  "name": "houseplantlab",
  "version": "0.2.0",
  "private": true,
  "description": "Build and validation tooling for the HouseplantLab WordPress project.",
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve-preview.mjs",
    "agents:typecheck": "tsc --noEmit -p editorial-agents/tsconfig.json",
    "agents:build": "tsc -p editorial-agents/tsconfig.build.json",
    "agents:test": "npm run agents:build && node --test --experimental-test-isolation=none editorial-agents/dist/tests/checks.test.js editorial-agents/dist/tests/image-workflow.test.js editorial-agents/dist/tests/live-publisher.test.js editorial-agents/dist/tests/publisher.test.js editorial-agents/dist/tests/queue.test.js editorial-agents/dist/tests/workflow.test.js",
    "agents:fixture": "npm run agents:build && node editorial-agents/dist/src/cli.js --fixture",
    "agents:live": "npm run agents:build && node editorial-agents/dist/src/cli.js --live",
    "agents:autonomous": "npm run agents:build && node editorial-agents/dist/src/autonomous-cli.js",
    "agents:autonomous:force": "npm run agents:build && node editorial-agents/dist/src/autonomous-cli.js --force",
    "agents:sync-wordpress": "npm run agents:build && node --env-file-if-exists=.env editorial-agents/dist/src/publish-cli.js",
    "agents:generate-image": "npm run agents:build && node --env-file-if-exists=.env editorial-agents/dist/src/image-cli.js",
    "agents:publish-with-image": "npm run agents:build && node --env-file-if-exists=.env editorial-agents/dist/src/live-publish-cli.js",
    "agents:status": "npm run agents:build && node editorial-agents/dist/src/status-cli.js",
    "test": "npm run check && npm run build && npm run agents:typecheck && npm run agents:test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@openai/agents": "^0.19.0",
    "openai": "^7.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
